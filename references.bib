@article{ngulaEpistemicVerbComplementation2026,
  title = {Epistemic Verb Complementation in Research Articles: {{A}} Corpus-Based Approach to the Verb Suggest in Two Disciplines},
  shorttitle = {Epistemic Verb Complementation in Research Articles},
