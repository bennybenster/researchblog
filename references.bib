@article{riaziTrustworthinessL2Writing2023,
  title = {Trustworthiness in {{L2}} Writing Research: {{A}} Review and Analysis of Qualitative Articles in the {{{\emph{Journal}}}}{\emph{ of }}{{{\emph{Second Language Writing}}}}},
  shorttitle = {Trustworthiness in {{L2}} Writing Research},
  author = {Riazi, A. Mehdi and Rezvani, Reza and Ghanbar, Hessameddin},
