  doi = {10.1016/j.jeap.2026.101653},
  urldate = {2026-03-26},
  abstract = {While studies on epistemic linguistic items -- such as lexical verbs -- abound in academic discourse, such items have received far less attention in terms of their complementation patterns despite insights derived from corpus linguistic work showing that the meanings expressed by words are often dependent on their phraseological behaviour. Using corpora and corpus analysis tools as the empirical method, this study investigates the disciplinary preferences of sociology and law writers of research articles (RAs) in the use of the morphological variants and the complementation patterns of the epistemic verb suggest. Two sub corpora of sociology and law RAs were constructed and analysed. The analysis shows that suggest occurs significantly more in sociology than in law and that both disciplines tend to prefer the base form [suggest] and the -s form [suggests], compared with the V -ed [suggested] and -ing [suggesting] forms. Even so, sociology RAs show a greater preference, compared with law RAs, for the use of the base form and the -s form. In terms of complementation patterns, the study reveals that suggest is used in a wide range of complementation patterns by writers of sociology and law, with the V that-clause being the predominant pattern in both disciplines although the pattern occurs significantly more in sociology than in law. The study further highlights how the evaluative functions of suggest in the V that-clause pattern may reflect how knowledge is constructed and conveyed in the two disciplines as well as discusses the pedagogical and theoretical implications of the findings.},
  langid = {english},
  file = {C:\Users\Ben\Zotero\storage\W2KIQERZ\Ngula and Seru - 2026 - Epistemic verb complementation in research articles A corpus-based approach to the verb suggest in.pdf}
}

